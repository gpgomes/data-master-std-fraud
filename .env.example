# ──────────────────────────────────────────────────────────────────────────────
# Data Master — Financial Fraud Detection Platform
# Copie este arquivo para .env e ajuste os valores antes de executar make up
# ──────────────────────────────────────────────────────────────────────────────

# ── Projeto ───────────────────────────────────────────────────────────────────
PROJECT_NAME=data-master-std-fraud
ENVIRONMENT=local

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_INTERNAL_SERVERS=kafka:9092
KAFKA_TOPIC_TRANSACTIONS=raw-transactions
KAFKA_TOPIC_MARKET_DATA=raw-market-data
KAFKA_TOPIC_ENRICHED=enriched-transactions
KAFKA_TOPIC_FRAUD_ALERTS=fraud-alerts
KAFKA_CONSUMER_GROUP=fraud-detection-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_REPLICATION_FACTOR=1
KAFKA_NUM_PARTITIONS=3

# ── Portas externas (host) ──────────────────────────────────────────────────────
# Ajuste apenas se a porta padrão já estiver em uso por outro processo/projeto
# na máquina local. Devem ficar consistentes com MINIO_ENDPOINT e POSTGRES_PORT.
MINIO_EXTERNAL_PORT=9000
POSTGRES_EXTERNAL_PORT=5432
API_EXTERNAL_PORT=8000

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold
MINIO_BUCKET_CHECKPOINTS=checkpoints

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_INTERNAL_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fraud_analytics
POSTGRES_USER=datamaster
POSTGRES_PASSWORD=datamaster123
POSTGRES_URL=postgresql://datamaster:datamaster123@localhost:5432/fraud_analytics

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_HOST=localhost
AIRFLOW_PORT=8082
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
AIRFLOW__WEBSERVER__SECRET_KEY=your-secret-key-here

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2

# ── Delta Lake ────────────────────────────────────────────────────────────────
DELTA_LAKE_PATH=s3a://silver/delta
DELTA_RETENTION_HOURS=168

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1
API_SECRET_KEY=your-api-secret-key-change-in-production

# ── Great Expectations ────────────────────────────────────────────────────────
GX_ROOT_DIR=src/governance/great_expectations
GX_DATA_DOCS_DIR=data_docs

# ── OpenMetadata ──────────────────────────────────────────────────────────────
OPENMETADATA_HOST=http://localhost:8585
OPENMETADATA_API_TOKEN=your-openmetadata-jwt-token

# ── APIs Externas (Dados de Mercado) ──────────────────────────────────────────
FINNHUB_API_KEY=your-finnhub-api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
YFINANCE_TICKERS=PETR4.SA,VALE3.SA,ITUB4.SA,BBDC4.SA,ABEV3.SA,WEGE3.SA,RENT3.SA,BBAS3.SA,MGLU3.SA,LREN3.SA

# ── Producer Streaming ────────────────────────────────────────────────────────
# Nomes devem bater com o que os producers de fato leem (issue #8) — ver
# src/ingestion/streaming/kafka_producer_transactions.py e kafka_producer_market.py
PRODUCER_RATE_TPS=10
MARKET_PRODUCER_RATE_TPS=50
GENERATOR_SEED=0
PRODUCER_LOG_LEVEL=INFO

# ── AWS (V2 — Cloud) ──────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=data-master-std-fraud
AWS_MSK_BOOTSTRAP_SERVERS=your-msk-bootstrap-servers
AWS_EMR_CLUSTER_ID=your-emr-cluster-id
AWS_MWAA_ENV_NAME=your-mwaa-env-name

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
